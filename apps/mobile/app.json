{
  "expo": {
    "name": "HERE",
    "slug": "here",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "here",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.iamhere.prototype",
      "icon": "./assets/here.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E11D49",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E11D49",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 190
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Yer bildirirken o an çektiğin fotoğrafı eklemek için kamerana erişilir.",
          "photosPermission": "Paylaşıma fotoğraf eklemek için fotoğraflarına erişilir.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
