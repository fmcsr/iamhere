# dbmate (.env dosyasını kendiliğinden okur). Migration'lar tablo sahibi rolle çalışır.
DATABASE_URL=postgres://anlik_owner:anlik_owner_dev@localhost:5432/anlik?sslmode=disable
DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_NO_DUMP_SCHEMA=true

# API'nin bağlanacağı rol (RLS'ye tabidir) — Adım 2'de kullanılacak
API_DATABASE_URL=postgres://anlik_api:anlik_api_dev@localhost:5432/anlik?sslmode=disable
REDIS_URL=redis://localhost:6379
